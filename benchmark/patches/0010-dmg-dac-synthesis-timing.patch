From 2d6ea110275b17de06d9d1c1a621adf625973cac Mon Sep 17 00:00:00 2001
From: Jeff Lynn <4128043+jefffm@users.noreply.github.com>
Date: Sun, 18 Oct 2026 04:29:07 -0400
Subject: [PATCH] APU: align DMG DAC envelopes with band-limited synthesis

Channel samples pass through the synthesis kernel, but per-DAC fades were
multiplied into those samples using the current CPU state. A DAC voltage
step therefore arrived about half a kernel before an equivalent digital
volume/routing step. With another DAC enabled, the recorded shutdown edges
on all four channels expose this discrepancy independently of mixer
connection or capacitor holding.

Queue the existing integer DAC gains and enable mask by the kernel's
midpoint, and use that same mask for mixer connection and DC-offset removal.
This preserves the fade curve and genuine voltage steps without shifting
the waveform path a second time. The enable mask also prevents DC-offset
mode from anticipating the delayed gain change. Keep the unfiltered path
and non-DMG models unchanged. The history lives in unsaved audio-output
state; CPU/APU register timing and persistent state are unchanged.

Under the original hardware packet alignment and gain, mixed-DAC shutdown
edges improve from 31.73-33.02 samples early to within -0.269 to 1.021 samples
at 48 kHz. Independent digital-zero, steady-tone and packet controls already
align, so the delay comes from the 64-tap synthesizer, not a hardware fit.
All eight DAC cases improve; CH1/CH2 retain a separate restart phase/level
difference. NOIZE JAMS aggregate correlation is effectively unchanged.

The focused timing regression fails 16 checks before and passes afterward,
including DC-offset timing. All 40 CGB control traces are byte-identical;
digital-source writes and the unfiltered bypass retain their timing. The
adapted shutdown/reconnect checks pass with the same pipeline latency.
The complete original hardware suite decodes 337/337 packets with zero
readback differences, unchanged CPU traces and lower waveform RMSE in all
189 cases under the frozen calibration.
---
 Core/apu.c | 28 ++++++++++++++++++++++------
 Core/apu.h |  5 +++++
 2 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/Core/apu.c b/Core/apu.c
index 9d343f31..904c05f2 100644
--- a/Core/apu.c
+++ b/Core/apu.c
@@ -321,7 +321,8 @@ static signed interference(GB_gameboy_t *gb)
 static void render(GB_gameboy_t *gb)
 {
     GB_sample_t output = {0, 0};
-    bool dac_output_connected = gb->model != GB_MODEL_DMG_B;
+    uint8_t enabled_dacs = 0;
+    bool delay_dac = gb->model == GB_MODEL_DMG_B && gb->apu_output.max_cycles_per_sample != 1;
 
     unrolled for (unsigned i = 0; i < GB_N_CHANNELS; i++) {
         double multiplier = CH_STEP;
@@ -348,14 +349,28 @@ static void render(GB_gameboy_t *gb)
             }
         }
         
-        dac_output_connected |= GB_apu_is_DAC_enabled(gb, i);
+        enabled_dacs |= GB_apu_is_DAC_enabled(gb, i) << i;
 
+        if (delay_dac) {
+            /* DAC gain is applied after synthesis. Match the filter's midpoint
+               delay so enabling a DAC cannot precede its digital waveform. */
+            uint8_t delayed = gb->apu_output.dac_delay[gb->apu_output.dac_delay_pos].multiplier[i];
+            gb->apu_output.dac_delay[gb->apu_output.dac_delay_pos].multiplier[i] = multiplier;
+            multiplier = delayed;
+        }
         GB_sample_t channel_output;
         band_limited_read(&gb->apu_output.band_limited[i], &channel_output, multiplier);
 
         output.left += channel_output.left;
         output.right += channel_output.right;
     }
+    if (delay_dac) {
+        uint8_t delayed = gb->apu_output.dac_delay[gb->apu_output.dac_delay_pos].enabled;
+        gb->apu_output.dac_delay[gb->apu_output.dac_delay_pos].enabled = enabled_dacs;
+        enabled_dacs = delayed;
+        gb->apu_output.dac_delay_pos =
+            (gb->apu_output.dac_delay_pos + 1) % (GB_BAND_LIMITED_WIDTH / 2);
+    }
     gb->apu_output.cycles_since_render = 0;
     if (unlikely(gb->apu_output.sample_fraction < (1 << 28))) {
         gb->apu_output.sample_fraction = 0;
@@ -367,9 +382,10 @@ static void render(GB_gameboy_t *gb)
     if (gb->sgb && gb->sgb->intro_animation < GB_SGB_INTRO_ANIMATION_LENGTH) return;
 
     GB_sample_t filtered_output = {0, 0};
-    /* On DMG, disabling the last DAC disconnects the mixer immediately. Keep
-       per-channel discharge running, but hold the coupling capacitor while disconnected. */
-    if (dac_output_connected) {
+    /* On DMG, the last DAC disconnects the mixer without waiting for discharge.
+       Apply the same synthesis delay to connection and gain, then hold the
+       coupling capacitor while disconnected. */
+    if (gb->model != GB_MODEL_DMG_B || enabled_dacs) {
         filtered_output = gb->apu_output.highpass_mode?
             (GB_sample_t) {output.left  - (int16_t)gb->apu_output.highpass_diff.left,
                            output.right - (int16_t)gb->apu_output.highpass_diff.right} :
@@ -390,7 +406,7 @@ static void render(GB_gameboy_t *gb)
                 unsigned left_volume = 0;
                 unsigned right_volume = 0;
                 unrolled for (unsigned i = GB_N_CHANNELS; i--;) {
-                    if (GB_apu_is_DAC_enabled(gb, i)) {
+                    if (enabled_dacs & (1 << i)) {
                         if (mask & 1) {
                             left_volume += ((gb->io_registers[GB_IO_NR50] & 7) + 1) * CH_STEP * 0xF;
                         }
diff --git a/Core/apu.h b/Core/apu.h
index cc3f4b14..3b827906 100644
--- a/Core/apu.h
+++ b/Core/apu.h
@@ -205,6 +205,11 @@ typedef struct {
     
     GB_band_limited_t band_limited[GB_N_CHANNELS];
     double dac_discharge[GB_N_CHANNELS];
+    struct {
+        uint8_t multiplier[GB_N_CHANNELS];
+        uint8_t enabled;
+    } dac_delay[GB_BAND_LIMITED_WIDTH / 2];
+    uint8_t dac_delay_pos;
     bool channel_muted[GB_N_CHANNELS];
     bool edge_triggered[GB_N_CHANNELS];
 
-- 
2.56.0

